# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true

# Storage: "memory" or "dynamodb"
STORAGE_BACKEND=memory

# AWS (only needed when STORAGE_BACKEND=dynamodb)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# S3
S3_BUCKET_NAME=docuvoice-uploads
S3_PRESIGNED_EXPIRY=300

# DynamoDB
DYNAMODB_TABLE_NAME=docuvoice-main
DYNAMODB_ENDPOINT_URL=

# LiveKit
LIVEKIT_URL=wss://placeholder.livekit.cloud
LIVEKIT_API_KEY=placeholder
LIVEKIT_API_SECRET=placeholder
