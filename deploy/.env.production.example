# ═══════════════════════════════════════════════════════════════════
# DocuVoice — Production Environment Variables
# Copy to backend/.env and agents/.env, then fill in your secrets.
# ═══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8000
CORS_ORIGINS=["https://novasonic-hackathon.sumanpaudel.me"]
STORAGE_BACKEND=dynamodb

# ── AWS Credentials ──────────────────────────────────────────────
# For hackathon: use temp session creds. For prod: use IAM role on EC2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# ── S3 ───────────────────────────────────────────────────────────
S3_BUCKET_NAME=docuvoice-uploads-<YOUR_ACCOUNT_ID>
S3_PRESIGNED_EXPIRY=300

# ── DynamoDB ─────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=docuvoice-main

# ── Bedrock ──────────────────────────────────────────────────────
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# ── LiveKit ──────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── LlamaParse (optional, for scanned PDFs) ──────────────────────
LLAMA_CLOUD_API_KEY=
